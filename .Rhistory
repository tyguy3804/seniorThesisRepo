library(tidyverse)
# Read all files into a list
storm_reports <- list.files("storm_reports/",
pattern = "\\.csv$",
full.names = TRUE) %>%
set_names(~str_extract(basename(.), "\\d{4}")) %>%
map(read_csv)
# Now you can easily:
# - Look at individual years: storm_reports[["1985"]]
# - Count reports by year: map_int(storm_reports, nrow)
# - Check column names: map(storm_reports, names)
# - Filter one year: storm_reports[["2020"]] %>% filter(STATE == "OK")
# Summary of all years
summary_df <- tibble(
year = names(storm_reports),
n_reports = map_int(storm_reports, nrow),
n_states = map_int(storm_reports, ~length(unique(.$STATE)))
)
print(summary_df)
